# =====================================================================
# EXAMPLE ONLY - never commit a real secrets file (kubernetes/**/secrets.yaml is git-ignored).
# Preferred: let scripts/deploy.sh create the Secret from your .env:
#   kubectl create secret generic shopsphere-secrets -n shopsphere-dev \
#     --from-literal=DB_USERNAME=shopsphere --from-literal=DB_PASSWORD='...' \
#     --from-literal=JWT_SECRET='...' --from-literal=ADMIN_PASSWORD='...'
# Production: store values in AWS Secrets Manager and sync them with the
# External Secrets Operator (Phase 23 hardening).
# Note: Kubernetes Secrets are only base64-encoded; EKS encrypts them at rest with KMS.
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: shopsphere-secrets
  namespace: shopsphere-dev
type: Opaque
stringData:
  DB_USERNAME: shopsphere
  DB_PASSWORD: <CHANGE_ME>
  JWT_SECRET: <OUTPUT_OF_openssl_rand_-base64_64>
  ADMIN_PASSWORD: <CHANGE_ME_MIN_8_CHARS>
