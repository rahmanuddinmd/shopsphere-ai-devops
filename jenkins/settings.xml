<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings used ONLY by Jenkins for `mvn deploy` to Nexus.
  Credentials come from the Jenkins credential 'nexus-credentials' (exposed as env vars
  NEXUS_USER / NEXUS_PASSWORD inside withCredentials). Nothing secret is stored in Git.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>nexus-releases</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>nexus-snapshots</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>
