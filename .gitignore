# =====================================================================
# ShopSphere AI - .gitignore
# Rule: build outputs, local state and anything secret never enter Git.
# =====================================================================

# ---------- Java / Maven ----------
target/
*.class
*.log
hs_err_pid*
replay_pid*
!.mvn/wrapper/maven-wrapper.jar

# ---------- Node / React / Vite ----------
node_modules/
dist/
build/
coverage/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Terraform ----------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# NOTE: .terraform.lock.hcl is intentionally committed (pins provider versions)

# ---------- Kubernetes / Helm ----------
kubeconfig
kubeconfig*
*.kubeconfig
kubernetes/secrets.yaml
**/secrets.env
kubernetes/**/secret.yaml
kubernetes/**/secrets.yaml
helm/**/charts/*.tgz
helm/**/values-secret*.yaml

# ---------- Secrets & credentials (NEVER commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
id_rsa*
id_ed25519*
.aws/
credentials
credentials.json
*.credentials

# ---------- Security scan reports (generated by Jenkins) ----------
dependency-check-report.*
security/reports/
trivy-*.json
trivy-*.html
trivy-*.sarif

# ---------- Terraform plan exports (may contain resource details) ----------
*.tfplan.json

# ---------- Local tool data (Docker volumes bound to host) ----------
.data/
volumes/

# ---------- IDE / OS ----------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
database/backups/

# ---------- Ansible ----------
ansible/inventory/hosts.ini
*.retry
