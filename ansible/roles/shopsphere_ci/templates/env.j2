# Generated by Ansible on first provisioning. Mode 600. Never commit this file.
SPRING_PROFILES_ACTIVE=docker
DB_NAME=shopsphere
DB_USERNAME=shopsphere
DB_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=24, chars=['ascii_letters', 'digits']) }}
JWT_SECRET={{ lookup('ansible.builtin.password', '/dev/null', length=64, chars=['ascii_letters', 'digits']) | b64encode }}
JWT_EXPIRATION_MINUTES=60
ADMIN_EMAIL=admin@shopsphere.local
ADMIN_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=20, chars=['ascii_letters', 'digits']) }}
AI_PROVIDER=disabled
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=20, chars=['ascii_letters', 'digits']) }}
{% if shopsphere_ci_enable_jcasc %}
# Jenkins Configuration-as-Code - fill these in on the server, then: docker compose --profile ci up -d jenkins
CASC_JENKINS_CONFIG=/var/jenkins_casc/enabled
JENKINS_JAVA_OPTS=-Djenkins.install.runSetupWizard=false
JENKINS_ADMIN_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=20, chars=['ascii_letters', 'digits']) }}
JENKINS_URL=http://{{ ansible_host }}:8085/
GITHUB_USER=rahmanuddinmd
GITHUB_TOKEN=
SONAR_TOKEN=
NEXUS_USER=
NEXUS_PASSWORD=
AWS_JENKINS_ACCESS_KEY_ID=
AWS_JENKINS_SECRET_ACCESS_KEY=
NVD_API_KEY=
{% endif %}
