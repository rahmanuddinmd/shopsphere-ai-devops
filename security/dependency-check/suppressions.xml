<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppressions.
  Suppress ONLY confirmed false positives (wrong CPE match) or accepted risks, always with:
    - a <notes> explanation, and
    - an `until` date so the suppression expires and is reviewed again.
  Example (kept commented out):
  <suppress until="2026-12-31Z">
    <notes><![CDATA[False positive: CPE for "postgresql" server matched the JDBC driver jar. Owner: @rahmanuddinmd]]></notes>
    <packageUrl regex="true">^pkg:maven/org\.postgresql/postgresql@.*$</packageUrl>
    <cpe>cpe:/a:postgresql:postgresql</cpe>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
