# =====================================================================
# ShopSphere AI - environment variable contract
# Copy to .env for local use:  cp .env.example .env
# .env is git-ignored. NEVER commit real values.
# These exact names are used by Spring Boot, Docker Compose, Jenkins,
# Kubernetes ConfigMaps/Secrets and Terraform outputs.
# =====================================================================

# ---------- Spring Boot ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopsphere
DB_USERNAME=shopsphere
DB_PASSWORD=<CHANGE_ME_LOCAL_DB_PASSWORD>

# ---------- Security ----------
# Generate with:  openssl rand -base64 64
JWT_SECRET=<CHANGE_ME_BASE64_SECRET_AT_LEAST_64_BYTES>
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap admin account created on first start (change after first login)
ADMIN_EMAIL=admin@shopsphere.local
ADMIN_PASSWORD=<CHANGE_ME_ADMIN_PASSWORD>

# ---------- AI ----------
# ollama | bedrock | disabled   (disabled = rule-based answers from catalog data)
AI_PROVIDER=disabled
# Backend running on your machine (./mvnw spring-boot:run):
OLLAMA_BASE_URL=http://localhost:11434
# Backend running inside Docker Compose (container-to-container):
OLLAMA_BASE_URL_DOCKER=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Used only when AI_PROVIDER=bedrock. Credentials come from the AWS default
# credential chain (local profile or EKS Pod Identity) - never from this file.
AWS_REGION=<YOUR_AWS_REGION>
BEDROCK_MODEL_ID=<BEDROCK_MODEL_ID_ENABLED_IN_YOUR_ACCOUNT>

# ---------- Frontend (build-time, Vite) ----------
# Default is the relative path /api: the Vite dev proxy, Nginx (Compose) or the Ingress (EKS)
# routes it to the backend. Leave unset unless the API lives on another origin.
# VITE_API_URL=/api

# ---------- Local tooling (Docker Compose) ----------
POSTGRES_PASSWORD=<CHANGE_ME_LOCAL_DB_PASSWORD>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME_GRAFANA_PASSWORD>

# ---------- Jenkins Configuration-as-Code (optional, CI server only) ----------
# Uncomment to configure Jenkins credentials automatically from jenkins/casc/jenkins.yaml
# CASC_JENKINS_CONFIG=/var/jenkins_casc/enabled
# JENKINS_JAVA_OPTS=-Djenkins.install.runSetupWizard=false
# JENKINS_ADMIN_PASSWORD=<CHANGE_ME>
# JENKINS_URL=http://localhost:8085/
# GITHUB_USER=rahmanuddinmd
# GITHUB_TOKEN=<FINE_GRAINED_PAT>
# SONAR_TOKEN=<SONARQUBE_TOKEN>
# NEXUS_USER=jenkins-deployer
# NEXUS_PASSWORD=<CHANGE_ME>
# AWS_JENKINS_ACCESS_KEY_ID=<KEY_OF_IAM_USER_shopsphere-dev-jenkins>
# AWS_JENKINS_SECRET_ACCESS_KEY=<SECRET>
# NVD_API_KEY=<FREE_KEY_FROM_nvd.nist.gov>
